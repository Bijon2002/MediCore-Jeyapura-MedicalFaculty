# Supabase Configuration
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-publishable-key"

# Optional daily medical news provider. NewsData.io supports worldwide and Sri Lankan health feeds.
VITE_NEWSDATA_API_KEY="your-newsdata-api-key"
# Optional fallback provider when NewsData is not configured.
VITE_GNEWS_API_KEY="your-gnews-api-key"
